  "print_format_for": "DocType",
  "print_format_type": "Jinja",
  "raw_printing": 0,
  "show_label_colon": 0,
  "show_section_headings": 0,
  "standard": "No"
 },
 {
  "absolute_value": 0,
  "align_labels_right": 0,
  "css": ".print-format { margin-top: 20mm; margin-bottom: 20mm; margin-left: 20mm; margin-right: 20mm; }",
  "custom_format": 1,
  "disabled": 0,
  "doc_type": "Team Monthly Report",
  "docstatus": 0,
  "doctype": "Print Format",
  "font_size": 14,
  "html": "<style>\n/* Page setup. \".print-format\" is read by Frappe's wkhtmltopdf PDF generator\n   (A4 portrait, 2cm margins = docx); @page covers Chrome-based PDF/preview. */\n.print-format { margin-top: 20mm; margin-bottom: 20mm; margin-left: 20mm; margin-right: 20mm; page-size: A4; orientation: Portrait; }\n@page { size: A4 portrait; margin: 20mm; }\n@media print { .print-format { margin: 0 !important; padding: 0 !important; } }\n\n.print-format .tmr { font-family: \"Lato Light\", \"Lato\", \"Helvetica Neue\", Helvetica, Arial, sans-serif; font-weight: 300; font-size: 11pt; color: #000; line-height: 1.3; }\n.print-format .tmr * { box-sizing: border-box; }\n.print-format .tmr p { margin: 0 0 8pt 0; }\n.print-format .tmr b, .print-format .tmr strong { font-weight: 700; }\n\n/* ---- cover (positions taken from the docx text boxes, mm from the margin box) */\n.print-format .tmr .tmr-cover { position: relative; height: 250mm; page-break-after: always; }\n.print-format .tmr .tmr-cover .mont { font-family: \"Montserrat ExtraLight\", \"Montserrat Light\", \"Montserrat\", \"Lato\", Arial, sans-serif; font-weight: 300; }\n.print-format .tmr .tmr-month { position: absolute; top: 10mm; left: 100mm; width: 70mm; text-align: center; font-size: 28pt; z-index: 2; }\n.print-format .tmr .tmr-cover-logo { position: absolute; top: 24mm; left: 0; width: 100%; text-align: center; z-index: 1; }\n.print-format .tmr .tmr-cover-logo img { width: 150mm; height: auto; }\n.print-format .tmr .tmr-line1 { position: absolute; top: 179mm; left: 0; width: 100%; font-size: 36pt; letter-spacing: 1px; }\n.print-format .tmr .tmr-line2 { position: absolute; top: 199mm; left: 0; width: 100%; font-size: 36pt; letter-spacing: 1px; }\n.print-format .tmr .tmr-wordmark { position: absolute; top: 240mm; left: 0; }\n.print-format .tmr .tmr-wordmark img { width: 52mm; height: auto; }\n\n/* ---- headings: Montserrat Light 14pt, exactly the docx strings */\n.print-format .tmr .tmr-h { font-family: \"Montserrat Light\", \"Montserrat\", \"Lato\", Arial, sans-serif; font-weight: 300; font-size: 14pt; margin: 18pt 0 10pt 0; page-break-after: avoid; }\n\n/* ---- NUXURKA sentences */\n.print-format .tmr .tmr-nx { margin: 0 0 9pt 0; }\n.print-format .tmr .tmr-nx b { font-weight: 700; }\n\n/* ---- tables (docx grid look: thin black borders, header repeats across pages) */\n.print-format .tmr table.tmr-t { width: 100%; border-collapse: collapse; table-layout: fixed; margin: 0 0 10pt 0; }\n.print-format .tmr table.tmr-t th,\n.print-format .tmr table.tmr-t td { border: 0.5pt solid #000 !important; padding: 3pt 5pt !important; font-size: 10pt; text-align: left; vertical-align: middle !important; word-wrap: break-word; overflow-wrap: break-word; }\n.print-format .tmr table.tmr-t th { font-weight: 700; background: transparent; }\n.print-format .tmr table.tmr-t thead { display: table-header-group; }\n.print-format .tmr table.tmr-t tr { page-break-inside: avoid; }\n.print-format .tmr table.tmr-t td.num, .print-format .tmr table.tmr-t th.num { text-align: left; }\n.print-format .tmr table.tmr-t tr.total td { font-weight: 700; }\n.print-format .tmr table.tmr-sum td.lbl { font-weight: 700; vertical-align: middle !important; }\n.print-format .tmr table.tmr-sum td.hd { font-weight: 700; }\n\n/* ---- MEELMARINTA */\n.print-format .tmr .tmr-sign { page-break-inside: avoid; margin-top: 14pt; }\n.print-format .tmr .tmr-sign p { margin: 0 0 4pt 0; }\n.print-format .tmr .tmr-sign .gap { height: 10pt; }\n.print-format .tmr .tmr-sign .line { border-bottom: 0.5pt solid #000; height: 14pt; margin-bottom: 6pt; }\n</style>\n\n{%- macro money(v) -%}${{ \"%.2f\"|format((v or 0)|float) }}{%- endmacro -%}\n\n<div class=\"tmr\">\n\n  <!-- ================= COVER ================= -->\n  <div class=\"tmr-cover\">\n    <div class=\"tmr-cover-logo\"><img src=\"/files/tmr_cover_logo.png\" alt=\"Yooltech\"></div>\n    <div class=\"tmr-month mont\">{{ (doc.month_label or \"\")|e }}</div>\n    <div class=\"tmr-line1 mont\">WARBIXIN BILAHA AH EE</div>\n    <div class=\"tmr-line2 mont\">XAFIISKA FARSAMADA</div>\n    <div class=\"tmr-wordmark\"><img src=\"/files/emr_yooltech_logo.png\" alt=\"Yooltech\"></div>\n  </div>\n\n  <!-- ================= HORDHAC ================= -->\n  <div class=\"tmr-h\">HORDHAC</div>\n  <div class=\"tmr-rich\">{{ doc.hordhac or \"\" }}</div>\n\n  <!-- ================= NUXURKA ================= -->\n  <div class=\"tmr-h\">NUXURKA WARBIXINTA BISHAN</div>\n  <p class=\"tmr-nx\"><b>Ciladaha:</b> {{ (doc.nuxur_cilado or \"\")|e }}</p>\n  <p class=\"tmr-nx\"><b>Macaamiisha:</b> {{ (doc.nuxur_macaamiil or \"\")|e }}</p>\n  <p class=\"tmr-nx\"><b>Injineerada:</b> {{ (doc.nuxur_injineer or \"\")|e }}</p>\n  <p class=\"tmr-nx\"><b>Kharashaadka:</b> {{ (doc.nuxur_kharash or \"\")|e }}</p>\n\n  <!-- summary block: three stacked mini-tables (one table, vertically merged labels) -->\n  <table class=\"tmr-t tmr-sum\">\n    <tr>\n      <td class=\"lbl\" rowspan=\"2\" style=\"width:28%;\">Macaamiisha<br>Soo Hadashay</td>\n      <td class=\"hd\" style=\"width:24%;\">Fariin</td>\n      <td class=\"hd\" style=\"width:24%;\">Wicitaan</td>\n      <td class=\"hd\" style=\"width:24%;\">Booqasho</td>\n    </tr>\n    <tr>\n      <td>{{ doc.fariin_count or 0 }}</td>\n      <td>{{ doc.wicitaan_count or 0 }}</td>\n      <td>{{ doc.booqasho_count or 0 }}</td>\n    </tr>\n    <tr>\n      <td class=\"lbl\" rowspan=\"2\">Macaamiisha<br>Shaqooyinka loo qabtay</td>\n      <td class=\"hd\">Macmiil Cusub</td>\n      <td class=\"hd\">Cilado la xaliyay</td>\n      <td class=\"hd\">Macmiil la booqday</td>\n    </tr>\n    <tr>\n      <td>{{ doc.new_clients_count or 0 }}</td>\n      <td>{{ doc.issues_resolved_count or 0 }}</td>\n      <td>{{ doc.clients_visited_count or 0 }}</td>\n    </tr>\n    <tr>\n      <td class=\"lbl\" rowspan=\"2\">Ciladaha<br>Macaamiisha</td>\n      <td class=\"hd\">Wadarta</td>\n      <td class=\"hd\">La xaliyay</td>\n      <td class=\"hd\">Aan la xalin</td>\n    </tr>\n    <tr>\n      <td>{{ doc.total_issues or 0 }}</td>\n      <td>{{ doc.resolved_count or 0 }}</td>\n      <td>{{ doc.unresolved_count or 0 }}</td>\n    </tr>\n  </table>\n\n  <!-- ================= CILADAHA ================= -->\n  <div class=\"tmr-h\">WARBIXNTA CILADAHA</div>\n  <p>Ciladaha bishaan ina soo gaaray waxey isugu jireen kuwo ciladahooda ay u baahantay in xarumahooda loogu tago iyo kuwa ciladahoodu ay fududaayeen oo lagu xaliyay hab online ah ayadoo la isticmaalayo RustDesk, Google Meating iyo Whatsapp mararka qaar.</p>\n  <p><b>Inta ugu badan ciladihi bishan in asoo gaaray waa laxaliyay marka laga reebo dhowr ciladood oo loo gudbiyay team ka developers ka kuwaasoo wali aan la xalin.</b></p>\n\n  <table class=\"tmr-t\">\n    <thead><tr>\n      <th style=\"width:8%;\">L .</th>\n      <th style=\"width:37%;\">Nuuca Cilada</th>\n      <th style=\"width:15%;\">Tirada</th>\n      <th style=\"width:17%;\">Boqolkiiba</th>\n      <th style=\"width:23%;\">Kharashaadka</th>\n    </tr></thead>\n    <tbody>\n    {%- set ns = namespace(n=0) %}\n    {%- for row in (doc.issue_rows or []) %}\n      <tr>\n        {%- if row.issue_type == \"Lama xirin ticket\" %}\n        <td></td>\n        {%- else %}{%- set ns.n = ns.n + 1 %}\n        <td>{{ ns.n }}</td>\n        {%- endif %}\n        <td>{{ (row.issue_type or \"\")|e }}</td>\n        <td class=\"num\">{{ row.ticket_count or 0 }}</td>\n        <td class=\"num\">{{ (row.pct or \"\")|e }}</td>\n        <td class=\"num\">{{ money(row.expense) }}</td>\n      </tr>\n    {%- endfor %}\n      <tr class=\"total\">\n        <td colspan=\"2\">Wadarta Ciladaha</td>\n        <td class=\"num\">{{ doc.total_issues or 0 }}</td>\n        <td class=\"num\">100%</td>\n        <td class=\"num\">{{ money(doc.total_expense) }}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <!-- ================= MACAAMIISHA ================= -->\n  <div class=\"tmr-h\">MACAAMIISHA SHAQOOYINKA LOO QABTAY</div>\n  <p><b>Waaxdeena waxa ay bishan u adeegtay {{ (doc.customer_rows or [])|length }} macmiil oo loo xaliyay {{ doc.total_issues or 0 }} ciladood waxaana inooga baxday lacag gaareysa {{ money(doc.total_expense) }} taasoo ka dhigeysa celcelis qarashaadka ku baxay cilad bixinta {{ money(doc.avg_expense_per_issue) }}</b></p>\n\n  <table class=\"tmr-t\">\n    <thead><tr>\n      <th style=\"width:7%;\">L</th>\n      <th style=\"width:33%;\">Magaca Macmilka</th>\n      <th style=\"width:12%;\">Ciladaha</th>\n      <th style=\"width:15%;\">Boqolkiba</th>\n      <th style=\"width:16%;\">Qarashka</th>\n      <th style=\"width:17%;\">Boqolkiba</th>\n    </tr></thead>\n    <tbody>\n    {%- for row in (doc.customer_rows or []) %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>{{ (row.customer_name or row.customer or \"\")|e }}</td>\n        <td class=\"num\">{{ row.ticket_count or 0 }}</td>\n        <td class=\"num\">{{ (row.ticket_pct or \"\")|e }}</td>\n        <td class=\"num\">{{ money(row.expense) }}</td>\n        <td class=\"num\">{{ (row.expense_pct or \"\")|e }}</td>\n      </tr>\n    {%- endfor %}\n      <tr class=\"total\">\n        <td colspan=\"2\">Wadarta Guud</td>\n        <td class=\"num\">{{ doc.total_issues or 0 }}</td>\n        <td class=\"num\">100.00%</td>\n        <td class=\"num\">{{ money(doc.total_expense) }}</td>\n        <td class=\"num\">100.00%</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <!-- ================= INJINEERADA ================= -->\n  <div class=\"tmr-h\">WAXQABADKA INJINEERADA FARSAMADA</div>\n  {%- set top_eng = ((doc.engineer_rows or []) | sort(attribute=\"ticket_count\", reverse=True) | list | first) if (doc.engineer_rows or []) else None %}\n  <p>Injineeradeyna waxey bishan muujiyeen dadaal dheeri ah ayagoo si dag dag ah uga jawaabay ciladaha ina soo gaaraya bishan, waxaana ciladaha ugu badan bishan xaliyay <b>{{ (top_eng.engineer_name if top_eng else \"\")|e }}</b> oo xaliyay <b>{{ (top_eng.pct if top_eng else \"\")|e }}</b> ciladaha bishan.</p>\n\n  <table class=\"tmr-t\">\n    <thead><tr>\n      <th style=\"width:32%;\">Magaca</th>\n      <th style=\"width:17%;\">Ciladaha guud</th>\n      <th style=\"width:17%;\">Overtime</th>\n      <th style=\"width:17%;\">Online</th>\n      <th style=\"width:17%;\">Boqolkiiba</th>\n    </tr></thead>\n    <tbody>\n    {%- for row in (doc.engineer_rows or []) %}\n      <tr>\n        <td>{{ (row.engineer_name or \"\")|e }}</td>\n        <td class=\"num\">{{ row.ticket_count or 0 }}</td>\n        <td class=\"num\">{{ row.overtime_count or 0 }}</td>\n        <td class=\"num\">{{ row.online_count or 0 }}</td>\n        <td class=\"num\">{{ (row.pct or \"\")|e }}</td>\n      </tr>\n    {%- endfor %}\n      <tr class=\"total\">\n        <td>Wadarta</td>\n        <td class=\"num\">{{ doc.total_issues or 0 }} Cilad</td>\n        <td class=\"num\">{{ (doc.engineer_rows or []) | map(attribute=\"overtime_count\") | map(\"int\") | sum }}</td>\n        <td class=\"num\">{{ (doc.engineer_rows or []) | map(attribute=\"online_count\") | map(\"int\") | sum }}</td>\n        <td class=\"num\">100%</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <!-- ================= CAQABADAHA ================= -->\n  <div class=\"tmr-h\">CAQABADAHA IYO XALKA</div>\n  <table class=\"tmr-t\">\n    <thead><tr>\n      <th style=\"width:50%;\">Caqabada</th>\n      <th style=\"width:50%;\">Xalka</th>\n    </tr></thead>\n    <tbody>\n    {%- for row in (doc.challenges or []) %}\n      <tr><td>{{ (row.challenge or \"\")|e }}</td><td>{{ (row.solution or \"\")|e }}</td></tr>\n    {%- else %}\n      <tr><td>&nbsp;</td><td>&nbsp;</td></tr>\n    {%- endfor %}\n    </tbody>\n  </table>\n\n  <!-- ================= FALCELINTA ================= -->\n  <div class=\"tmr-h\">FALCELINTA MACAAMIISHA</div>\n  <table class=\"tmr-t\">\n    <thead><tr>\n      <th style=\"width:35%;\">Magaca Macmiilka</th>\n      <th style=\"width:65%;\">Falcelinta Macmiilka</th>\n    </tr></thead>\n    <tbody>\n    {%- for row in (doc.feedback_rows or []) %}\n      <tr><td>{{ (row.client_name or \"\")|e }}</td><td>{{ (row.feedback or \"\")|e }}</td></tr>\n    {%- else %}\n      <tr><td>&nbsp;</td><td>&nbsp;</td></tr>\n    {%- endfor %}\n    </tbody>\n  </table>\n\n  <!-- ================= MEELMARINTA ================= -->\n  <div class=\"tmr-h\">MEELMARINTA WARBIXINTA</div>\n  <div class=\"tmr-sign\">\n    <p><b>Diyaariyay</b></p>\n    <p>{{ (doc.prepared_by_name or \"\")|e }}</p>\n    <p>Head of technical engineer</p>\n    <p>Yooltech</p>\n    <div class=\"gap\"></div>\n    <p><b>Saxiixa</b></p>\n    <div class=\"line\"></div>\n    <p><b>Taariikhda</b></p>\n    <div class=\"line\"></div>\n  </div>\n  <div class=\"tmr-sign\">\n    <div class=\"gap\"></div>\n    <p><b>Ansixiyay</b></p>\n    <p>Yooltech</p>\n    <p><b>saxiixa</b></p>\n    <div class=\"line\"></div>\n    <p><b>Taariikhda</b></p>\n    <div class=\"line\"></div>\n  </div>\n</div>\n",
