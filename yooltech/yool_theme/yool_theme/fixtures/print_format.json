  "doctype": "Print Format",
  "font_size": 14,
  "html": "<style>\n/* Page setup. The plain \".print-format\" rule is read by Frappe's PDF generator as wkhtmltopdf options\n   (A4 portrait, margins = docx: top 1440tw, left/right 1134tw, bottom 1127tw). @page is for Chrome PDF. */\n.print-format { margin-top: 25.4mm; margin-bottom: 19.9mm; margin-left: 20mm; margin-right: 20mm; page-size: A4; orientation: Portrait; }\n@page { size: A4 portrait; margin: 25.4mm 20mm 19.9mm 20mm; }\n@media print { .print-format { margin: 0 !important; padding: 0 !important; } }\n\n.print-format .emr { font-family: \"Lato Light\", \"Lato\", \"Helvetica Neue\", Helvetica, Arial, sans-serif; font-weight: 300; font-size: 10pt; color: #0D0D0D; line-height: 1.25; }\n.print-format .emr * { box-sizing: border-box; }\n.print-format .emr .emr-top { height: 14mm; }\n.print-format .emr table.emr-head { width: 100%; border-collapse: collapse; margin: 0; }\n.print-format .emr table.emr-head td { border: none !important; padding: 0 !important; vertical-align: top !important; }\n.print-format .emr .emr-title { font-family: \"Montserrat Light\", \"Montserrat\", \"Lato Light\", \"Lato\", Arial, sans-serif; font-weight: 300; font-size: 18pt; line-height: 1.2; color: #00AB9A; text-transform: none; margin: 0; }\n.print-format .emr .emr-logo { width: 40.3mm; height: 11.3mm; margin-top: 1mm; }\n.print-format .emr .emr-date { text-align: right; font-size: 11pt; margin: 15pt 0 0 0; }\n.print-format .emr .emr-name { text-align: right; font-size: 11pt; font-weight: 700; margin: 0; }\n.print-format .emr .emr-h { font-size: 11pt; font-weight: 700; color: #00AB9A; margin: 15pt 0 10pt 0; padding: 0; page-break-after: avoid; }\n.print-format .emr .emr-h .n { display: inline-block; width: 5mm; color: #00AB9A; }\n\n.print-format .emr table.emr-t { width: 100%; border-collapse: collapse; table-layout: fixed; margin: 0; border-top: 0.5pt solid #000; border-bottom: 0.5pt solid #000; }\n.print-format .emr table.emr-t th,\n.print-format .emr table.emr-t td { border: none !important; border-top: 0.5pt solid #000 !important; padding: 6pt 4pt 6pt 1.5pt !important; font-size: 10pt; text-align: left; vertical-align: middle !important; word-wrap: break-word; overflow-wrap: break-word; }\n.print-format .emr table.emr-t th { font-weight: 700; color: #0D0D0D; background: transparent; }\n.print-format .emr table.emr-t td { color: #7F7F7F; white-space: pre-wrap; }\n.print-format .emr table.emr-act td { padding-top: 3pt !important; padding-bottom: 3pt !important; vertical-align: top !important; }\n.print-format .emr table.emr-t thead { display: table-header-group; }\n.print-format .emr table.emr-t tr { page-break-inside: avoid; }\n.print-format .emr .emr-missing { font-size: 9pt; color: #7F7F7F; margin: 6pt 0 0 0; }\n\n/* signature / comment boxes: only the lines the docx shows */\n.print-format .emr table.emr-box { width: 100%; border-collapse: collapse; table-layout: fixed; margin: 0; border-bottom: 0.5pt solid #000; }\n.print-format .emr table.emr-box td { border: none !important; padding: 6pt 4pt 6pt 1.5pt !important; font-size: 10pt; vertical-align: top !important; }\n.print-format .emr table.emr-box td.lbl { font-weight: 700; color: #0D0D0D; }\n.print-format .emr table.emr-box td.blank { height: 22pt; }\n.print-format .emr table.emr-box td.cmt { color: #0D0D0D; white-space: pre-wrap; height: 66pt; border-bottom: 0.5pt solid #000 !important; }\n.print-format .emr .emr-gap { height: 12pt; }\n\n.print-format .emr .emr-instr { background: #EDFAF7; padding: 6pt 14pt 10pt 14pt; page-break-inside: avoid; }\n.print-format .emr .emr-instr .ih { font-size: 9pt; color: #00AB9A; margin: 6pt 0 3pt 0; }\n.print-format .emr .emr-instr ul { margin: 0; padding-left: 14pt; }\n.print-format .emr .emr-instr li { font-size: 9pt; color: #0D0D0D; margin: 6pt 0 3pt 0; }\n.print-format .emr .emr-instr li b { font-weight: 700; }\n</style>\n\n{%- macro d_slash(d) -%}{% if d %}{{ frappe.utils.formatdate(d, \"dd/MM/yyyy\") }}{% endif %}{%- endmacro -%}\n{%- macro num(v) -%}{% if v %}{{ \"%g\"|format(v|float) }}{% endif %}{%- endmacro -%}\n\n<div class=\"emr\">\n  <div class=\"emr-top\"></div>\n  <table class=\"emr-head\">\n    <tr>\n      <td style=\"width:65%;\"><div class=\"emr-title\">MONTHLY REPORT FOR<br>TECHNICAL ENGINEERS</div></td>\n      <td style=\"width:35%; text-align:right;\"><img class=\"emr-logo\" src=\"/files/emr_yooltech_logo.png\" alt=\"Yooltech\"></td>\n    </tr>\n  </table>\n\n  <p class=\"emr-date\">{% if doc.report_date %}{{ frappe.utils.formatdate(doc.report_date, \"d.M.yyyy\") }}{% endif %}</p>\n  <p class=\"emr-name\">{{ (doc.engineer_name or \"\")|e }}</p>\n\n  <div class=\"emr-h\"><span class=\"n\">1-</span>Summary of Activities</div>\n  <table class=\"emr-t\">\n    <thead><tr>\n      <th style=\"width:32.4%;\">Number of Works Done</th>\n      <th style=\"width:22.5%;\">New Clients</th>\n      <th style=\"width:22.55%;\">Issue Resolved</th>\n      <th style=\"width:22.55%;\">Clients Visited</th>\n    </tr></thead>\n    <tbody><tr>\n      <td>{{ doc.works_done or 0 }}</td>\n      <td>{{ doc.new_clients or 0 }}</td>\n      <td>{{ doc.issues_resolved or 0 }}</td>\n      <td>{{ doc.clients_visited or 0 }}</td>\n    </tr></tbody>\n  </table>\n\n  <div class=\"emr-h\"><span class=\"n\">2-</span>Detailed Activity Log</div>\n  <table class=\"emr-t emr-act\">\n    <thead><tr>\n      <th style=\"width:5%;\">#</th>\n      <th style=\"width:13%;\">Date</th>\n      <th style=\"width:18%;\">Client Name</th>\n      <th style=\"width:21%;\">Issue</th>\n      <th style=\"width:12%;\">Solved by</th>\n      <th style=\"width:9%;\">Time</th>\n      <th style=\"width:11%;\">Status</th>\n      <th style=\"width:11%;\">Visit cost</th>\n    </tr></thead>\n    <tbody>\n    {%- for row in doc.activities %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>{{ d_slash(row.activity_date) }}</td>\n        <td>{{ (row.client_name or \"\")|e }}</td>\n        <td>{{ (row.issue or \"\")|e }}</td>\n        <td>{{ (row.solved_by or \"\")|e }}</td>\n        <td>{{ (row.time_spent_text or \"\")|e }}</td>\n        <td>{{ (row.activity_status or \"\")|e }}</td>\n        <td>{{ num(row.visit_cost) }}</td>\n      </tr>\n    {%- endfor %}\n    </tbody>\n  </table>\n  <p class=\"emr-missing\">Rows missing time: {{ doc.missing_time_count or 0 }}</p>\n\n  <div class=\"emr-h\"><span class=\"n\">3-</span>Challenges and Solutions</div>\n  <table class=\"emr-t\">\n    <thead><tr><th style=\"width:50%;\">Challenge</th><th style=\"width:50%;\">Solution</th></tr></thead>\n    <tbody>\n    {%- for row in doc.challenges %}\n      <tr><td>{{ (row.challenge or \"\")|e }}</td><td>{{ (row.solution or \"\")|e }}</td></tr>\n    {%- endfor %}\n    </tbody>\n  </table>\n\n  <div class=\"emr-h\"><span class=\"n\">4-</span>Client Feedback</div>\n  <table class=\"emr-t\">\n    <thead><tr><th style=\"width:32.4%;\">Client Name</th><th style=\"width:67.6%;\">Feedback</th></tr></thead>\n    <tbody>\n    {%- for row in doc.feedback %}\n      <tr><td>{{ (row.client_name or \"\")|e }}</td><td>{{ (row.feedback or \"\")|e }}</td></tr>\n    {%- endfor %}\n    </tbody>\n  </table>\n\n  <div class=\"emr-h\"><span class=\"n\">5-</span>Signature and Additional Comments</div>\n  <table class=\"emr-box\">\n    <tr><td class=\"lbl\" style=\"width:50%;\">Technical Engineer&rsquo;s Signature</td><td class=\"lbl\" style=\"width:50%;\">Date</td></tr>\n    <tr><td class=\"blank\"></td><td class=\"blank\"></td></tr>\n  </table>\n\n  <div class=\"emr-gap\"></div>\n  <table class=\"emr-box\" style=\"page-break-inside: avoid;\">\n    <tr><td class=\"lbl\" colspan=\"2\">Engineer&rsquo;s Comment</td></tr>\n    <tr><td class=\"cmt\" colspan=\"2\">{{ (doc.engineer_comment or \"\")|e }}</td></tr>\n  </table>\n\n  <div class=\"emr-gap\"></div>\n  <table class=\"emr-box\" style=\"page-break-inside: avoid;\">\n    <tr><td class=\"lbl\" colspan=\"2\">Head of Technical Team&rsquo;s Comment</td></tr>\n    <tr><td class=\"cmt\" colspan=\"2\">{{ (doc.head_comment or \"\")|e }}</td></tr>\n    <tr><td class=\"lbl\" style=\"width:50%;\">Head of Technical Team&rsquo;s Signature</td><td class=\"lbl\" style=\"width:50%;\">Date</td></tr>\n    <tr><td class=\"blank\"></td><td class=\"blank\"></td></tr>\n  </table>\n\n  <div class=\"emr-gap\"></div>\n  <div class=\"emr-instr\">\n    <div class=\"ih\">Instructions for Technical Enginee:</div>\n    <ul>\n      <li><b>Fill Out Daily:</b> Complete the detailed activity log daily to ensure accuracy and consistency.</li>\n      <li><b>Compile Monthly:</b> At the end of each month, compile your daily logs into a comprehensive monthly report.</li>\n      <li><b>Submit Monthly:</b> Submit the monthly report to your Team Lead by the last working day of the month, no later than 5 PM.</li>\n      <li><b>Be Detailed:</b> Provide as much detail as possible, especially in the sections for key achievements and challenges.</li>\n      <li><b>Seek Feedback:</b> Use Team Lead comments from previous months to improve your performance and report quality in the following months.</li>\n    </ul>\n  </div>\n</div>\n",
  "line_breaks": 0,
  "margin_bottom": 19.9,
  "margin_left": 20,
